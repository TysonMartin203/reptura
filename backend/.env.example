# Local dev — copy to .env and fill in
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=workout_tracker

JWT_SECRET=replace_with_long_random_string

# Railway sets MYSQL_URL automatically — you don't need to set it
# MYSQL_URL=mysql://user:pass@host:port/dbname

PORT=5000

# After deploying frontend to Netlify, paste its URL here (no trailing slash)
# Every origin the frontend is served from, comma-separated, no trailing
# slashes. A browser treats each of these as a separate origin, so all of
# them need listing or their API calls get blocked by CORS:
#   https://reptura.fit,https://www.reptura.fit,https://fittrack100.netlify.app
CLIENT_URL=http://localhost:5173

# Instacart Developer Platform — get this from your Instacart Developer
# Dashboard after signup. Leave INSTACART_ENV as "development" until your
# production key is approved, then switch it to "production".
INSTACART_API_KEY=
INSTACART_ENV=development

# Kroger Developer Platform — register an app at developer.kroger.com with
# scopes "product.compact cart.basic:write profile.compact" and a redirect
# URI of {SERVER_URL}/api/kroger/callback (see SERVER_URL below).
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Kroger's own environment split — "certification" is their sandbox for
# testing before they approve your app for real carts; switch to
# "production" once approved.
KROGER_ENV=certification

# Your backend's own public URL (Railway gives you one after deploying) —
# needed so Kroger knows where to redirect back to after a user logs in.
# No trailing slash.
SERVER_URL=http://localhost:5000
